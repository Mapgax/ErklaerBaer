# ErklaerBaer local secrets and deployment-specific identifiers.
# Copy to .env. Never commit .env or any downloaded credential JSON file.

# Safe default: external writes and paid API calls remain disabled.
DRY_RUN=true

# Supplied by the owner. Apply a low provider-side spending limit.
ANTHROPIC_API_KEY=

# Supplied by the owner from the dedicated BFL project under API -> Keys.
# Used only for the one-time, local mascot-design pass. Do not add this key to
# GitHub Actions: recurring production must not call BFL.
# Buy at most USD 10 of prepaid credits, keep auto top-up disabled, and set
# provider-side project spending limits before adding the key here.
BFL_API_KEY=

# Rive is an interactive authoring tool for the approved mascot rig. It needs
# no repository environment variable or API key. Do not put Rive login details
# in this file.

# Supplied by the owner after creating the Google Cloud project.
GOOGLE_CLOUD_PROJECT=
# Local absolute path only. The file must grant Text-to-Speech access only.
GOOGLE_APPLICATION_CREDENTIALS=

# Supplied from a Google OAuth desktop-client configuration.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Generated by: python3 -m erklaerbaer setup-youtube
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Created or detected by setup-youtube.
YOUTUBE_PLAYLIST_DE_ID=
YOUTUBE_PLAYLIST_NL_ID=

# Change to true only after YouTube confirms the API compliance audit.
YOUTUBE_API_AUDIT_COMPLETE=false

# CI uses a JSON secret rather than this local file-path variable:
# GOOGLE_TTS_CREDENTIALS_JSON=<entire service-account JSON, GitHub Secret only>
#
# The MINT-Bot repository separately needs this GitHub Secret:
# ERKLAERBAER_DISPATCH_TOKEN=<fine-grained token for ErklaerBaer dispatch only>
# Production is additionally gated by GitHub variables, initially both false:
# ErklaerBaer: PRODUCTION_ENABLED=false
# MINT-Bot: ERKLAERBAER_ENABLED=false

# Optional private weekly feed; local only. Distinct from MINT_WRITE_TOKEN.
# Never put this credential in a URL, public artifact or workflow log.
ERKLAERBAER_FAVORITES_URL=https://mint-bot-nine.vercel.app/api/production-favorites
ERKLAERBAER_READ_TOKEN=
